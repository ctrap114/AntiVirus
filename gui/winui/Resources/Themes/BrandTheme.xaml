<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <!-- ============================================================
       Everbloom Security - Brand Theme Resources
       Design Tokens for Everbloom Security (WinUI 3)
       Win10/Win11 Adaptive via Material Adapters
  ============================================================ -->

  <!-- ============================================================
       COLOR PALETTE - Brand Tokens
       Core Principle: Crimson = Accent Only, Never Flood
  ============================================================ -->

  <!-- Core Brand Colors -->
  <Color x:Key="BrandCrimson">#C83B55</Color>
  <Color x:Key="BrandCrimsonHover">#D95B72</Color>
  <Color x:Key="BrandCrimsonPressed">#A82E44</Color>
  <Color x:Key="BrandCrimsonSubtle">#8E5363</Color>
  <Color x:Key="BrandCrimsonSubtleHover">#A86B7A</Color>

  <!-- Surface Colors - Win10 Dark Base / Win11 Mica Base -->
  <Color x:Key="ColorBackground">#121216</Color>        <!-- Background - Night -->
  <Color x:Key="ColorBackgroundAlt">#1A1A20</Color>    <!-- Surface - Elevated -->
  <Color x:Key="ColorCard">#211F25</Color>              <!-- Card Background -->
  <Color x:Key="ColorCardHover">#2A2A30</Color>         <!-- Card Hover -->
  <Color x:Key="ColorCardPressed">#1E1E28</Color>       <!-- Card Pressed -->

  <!-- Navigation / Chrome -->
  <Color x:Key="ColorNavigationBackground">#17171D</Color>
  <Color x:Key="ColorNavigationHover">#1F1F28</Color>

  <!-- Text -->
  <Color x:Key="ColorTextPrimary">#F5F1F2</Color>       <!-- Primary Text - Moon White -->
  <Color x:Key="ColorTextSecondary">#AAA4A8</Color>     <!-- Secondary Text - Muted -->
  <Color x:Key="ColorTextMuted">#7A7580</Color>         <!-- Muted/Disabled -->
  <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>      <!-- Text on Crimson -->

  <!-- Borders & Dividers -->
  <Color x:Key="ColorBorder">#343039</Color>            <!-- Default Border -->
  <Color x:Key="ColorBorderHover">#7D3346</Color>       <!-- Hover Border - Crimson Glow -->
  <Color x:Key="ColorBorderActive">#C83B55</Color>      <!-- Active/Focus Border -->
  <Color x:Key="ColorDivider">#2A2A35</Color>           <!-- Subtle Dividers -->

  <!-- Accent States -->
  <Color x:Key="ColorAccent">#C83B55</Color>
  <Color x:Key="ColorAccentHover">#D95B72</Color>
  <Color x:Key="ColorAccentPressed">#A82E44</Color>
  <Color x:Key="ColorAccentSubtle">#8E5363</Color>

  <!-- Semantic States -->
  <Color x:Key="ColorSuccess">#2E8B57</Color>           <!-- Success / Safe -->
  <Color x:Key="ColorWarning">#E8A838</Color>           <!-- Warning -->
  <Color x:Key="ColorError">#E04040</Color>             <!-- Error / Critical -->
  <Color x:Key="ColorInfo">#5A9FD8</Color>              <!-- Info -->

  <!-- Threat Severity -->
  <Color x:Key="SeverityCritical">#E04040</Color>
  <Color x:Key="SeverityHigh">#E04040</Color>
  <Color x:Key="SeverityMedium">#E8A838</Color>
  <Color x:Key="SeverityLow">#5A9FD8</Color>
  <Color x:Key="SeverityInfo">#5A9FD8</Color>

  <!-- Scan Ring / Progress -->
  <Color x:Key="ScanRingTrack">#2A2A35</Color>
  <Color x:Key="ScanRingProgress">#C83B55</Color>
  <Color x:Key="ScanRingPetal">#D95B72</Color>

  <!-- Petal Particle -->
  <Color x:Key="PetalColor">#D95B72</Color>
  <Color x:Key="PetalGlow">#FF6B8A</Color>

  <!-- Acrylic / Mica Tints -->
  <Color x:Key="AcrylicTintWin10">#1A1A20</Color>
  <Color x:Key="AcrylicTintOpacity">0.85</Color>
  <Color x:Key="AcrylicLuminosityOpacity">0.45</Color>

  <!-- Mica Fallback (Win10) -->
  <Color x:Key="MicaFallback">#1A1A20</Color>

  <!-- ============================================================
       TYPOGRAPHY
       Segoe UI Variable (EN) / Microsoft YaHei UI (ZH)
  ============================================================ -->

  <FontFamily x:Key="FontFamilyDefault">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas</FontFamily>

  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
  <x:Double x:Key="FontSizeSubtitle">15</x:Double>
  <x:Double x:Key="FontSizeTitle">18</x:Double>
  <x:Double x:Key="FontSizeTitleLarge">22</x:Double>
  <x:Double x:Key="FontSizeDisplay">28</x:Double>
  <x:Double x:Key="FontSizeHero">36</x:Double>

  <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
  <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
  <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

  <x:Double x:Key="LineHeightTight">1.2</x:Double>
  <x:Double x:Key="LineHeightNormal">1.4</x:Double>
  <x:Double x:Key="LineHeightRelaxed">1.6</x:Double>

  <!-- ============================================================
       SPACING SCALE (4px base)
  ============================================================ -->

  <x:Double x:Key="Space0">0</x:Double>
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space7">28</x:Double>
  <x:Double x:Key="Space8">32</x:Double>
  <x:Double x:Key="Space10">40</x:Double>
  <x:Double x:Key="Space12">48</x:Double>
  <x:Double x:Key="Space16">64</x:Double>

  <!-- ============================================================
       CORNER RADII
       Win10: Smaller (Sharp/Tool-like) | Win11: Larger (Soft)
       Base tokens here; Adapters override per platform
  ============================================================ -->

  <x:Double x:Key="RadiusXS">4</x:Double>       <!-- Button (Win10) / Small Chips -->
  <x:Double x:Key="RadiusSM">6</x:Double>       <!-- Button (Win10) -->
  <x:Double x:Key="RadiusMD">8</x:Double>       <!-- Card (Win10) / Button (Win11) -->
  <x:Double x:Key="RadiusLG">10</x:Double>      <!-- Card (Win11) / Dialog (Win10) -->
  <x:Double x:Key="RadiusLG2">12</x:Double>     <!-- Card (Win11) / Dialog (Win11) -->
  <x:Double x:Key="RadiusXL">16</x:Double>      <!-- Dialog (Win11) / Large Cards -->
  <x:Double x:Key="RadiusXL2">20</x:Double>     <!-- Large Dialogs -->
  <x:Double x:Key="RadiusFull">9999</x:Double>  <!-- Pills / Pills -->

  <!-- Sword Accent - Slash Angle -->
  <x:Double x:Key="SwordSlashAngle">15</x:Double>  <!-- Degrees for slash accent -->

  <!-- ============================================================
       ELEVATION / SHADOWS
  ============================================================ -->

  <x:Double x:Key="ShadowOpacityLow">0.08</x:Double>
  <x:Double x:Key="ShadowOpacityMedium">0.16</x:Double>
  <x:Double x:Key="ShadowOpacityHigh">0.24</x:Double>

  <x:Double x:Key="ShadowBlurLow">4</x:Double>
  <x:Double x:Key="ShadowBlurMedium">12</x:Double>
  <x:Double x:Key="ShadowBlurHigh">24</x:Double>

  <!-- ============================================================
       ANIMATION DURATIONS
  ============================================================ -->

  <x:Double x:Key="DurationFast">120</x:Double>       <!-- ms - Hover, Press -->
  <x:Double x:Key="DurationNormal">200</x:Double>      <!-- Transitions -->
  <x:Double x:Key="DurationSlow">300</x:Double>        <!-- Panel Expand/Collapse -->
  <x:Double x:Key="DurationSlow2">400</x:Double>       <!-- Panel Slide -->
  <x:Double x:Key="DurationSlow3">500</x:Double>       <!-- Page Transitions -->
  <x:Double x:Key="DurationPetal">3000</x:Double>      <!-- Petal Fall Animation -->

  <!-- Easing Functions -->
  <EasingFunction x:Key="EasingStandard" EasingMode="EaseOut">
    <CubicEase EasingMode="EaseOut" />
  </EasingFunction>
  <EasingFunction x:Key="EasingAccelerate" EasingMode="EaseIn">
    <CubicEase EasingMode="EaseIn" />
  </EasingFunction>
  <EasingFunction x:Key="EasingDecelerate" EasingMode="EaseOut">
    <CubicEase EasingMode="EaseOut" />
  </EasingFunction>
  <EasingFunction x:Key="EasingStandardSmooth" EasingMode="EaseInOut">
    <CubicEase EasingMode="EaseInOut" />
  </EasingFunction>
  <EasingFunction x:Key="EasingPetal" EasingMode="EaseOut">
    <QuadraticEase EasingMode="EaseOut" />
  </EasingFunction>

  <!-- ============================================================
       SCAN RING / PETALFALL PARAMETERS
  ============================================================ -->

  <x:Double x:Key="ScanRingThickness">4</x:Double>
  <x:Double x:Key="ScanRingRadius">48</x:Double>
  <x:Double x:Key="ScanRingGap">0.15</x:Double>           <!-- Gap in ring (0-1) -->
  <x:Double x:Key="PetalSize">6</x:Double>
  <x:Double x:Key="PetalCount">12</x:Double>
  <x:Double x:Key="PetalOpacity">0.04</x:Double>           <!-- 2-5% opacity -->
  <x:Double x:Key="PetalTrailLength">5</x:Double>
  <x:Double x:Key="PetalFallDuration">3000</x:Double>     -- ms

  <!-- ============================================================
       SCAN RING GEOMETRY
  ============================================================ -->

  <x:Double x:Key="ScanRingRadiusOuter">52</x:Double>
  <x:Double x:Key="ScanRingThickness">4</x:Double>
  <x:Double x:Key="ScanRingStartAngle">-90</x:Double>     -- Start at top
  <x:Double x:Key="ScanRingSweepMax">360</x:Double>

  <!-- Petal Particle -->
  <x:Double x:Key="PetalParticleSize">5</x:Double>
  <x:Double x:Key="PetalParticleCount">8</x:Double>
  <x:Double x:Key="PetalParticleOpacity">0.04</x:Double>
  <x:Double x:Key="PetalTrailLength">5</x:Double>
  <x:Double x:Key="PetalFallDuration">3000</x:Double>

  <!-- ============================================================
       SWORD ACCENT GEOMETRY
  ============================================================ -->

  <x:Double x:Key="SwordSlashAngle">15</x:Double>
  <x:Double x:Key="SwordSlashWidth">2</x:Double>
  <x:Double x:Key="SwordSlashLength">24</x:Double>

  <!-- ============================================================
       CARD / PANEL DEFAULTS
  ============================================================ -->

  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="CardPaddingCompact">12</Thickness>
  <Thickness x:Key="CardMargin">0,0,0,8</Thickness>
  <Thickness x:Key="CardBorderThickness">1</Thickness>

  <!-- ============================================================
       BUTTON DEFAULTS
  ============================================================ -->

  <Thickness x:Key="ButtonPadding">14,8,14,8</Thickness>
  <Thickness x:Key="ButtonPaddingCompact">12,6,12,6</Thickness>
  <Thickness x:Key="ButtonPaddingLarge">20,12,20,12</Thickness>
  <x:Double x:Key="ButtonMinWidth">120</x:Double>
  <x:Double x:Key="ButtonMinHeight">36</x:Double>

  <!-- ============================================================
       NAVIGATION VIEW
  ============================================================ -->

  <x:Double x:Key="NavPaneCompactWidth">48</x:Double>
  <x:Double x:Key="NavPaneExpandedWidth">240</x:Double>
  <x:Double x:Key="NavItemHeight">40</x:Double>
  <x:Double x:Key="NavItemSpacing">4</x:Double>
  <x:Double x:Key="NavItemCornerRadius">8</x:Double>
  <x:Double x:Key="NavIndicatorWidth">3</x:Double>
  <x:Double x:Key="NavIndicatorMargin">8,0,0,0</x:Double>

  <!-- ============================================================
       SCAN RING / PETALFALL ANIMATION
  ============================================================ -->

  <x:Double x:Key="ScanRingRadius">48</x:Double>
  <x:Double x:Key="ScanRingThickness">4</x:Double>
  <x:Double x:Key="ScanRingGapRatio">0.15</x:Double>
  <x:Double x:Key="ScanDuration">3000</x:Double>

  <!-- Petalfall Particle -->
  <x:Double x:Key="PetalSize">6</x:Double>
  <x:Double x:Key="PetalCount">12</x:Double>
  <x:Double x:Key="PetalOpacity">0.04</x:Double>
  <x:Double x:Key="PetalTrailLength">5</x:Double>
  <x:Double x:Key="PetalFallDuration">3000</x:Double>

  <!-- Petal Particle System -->
  <x:Double x:Key="PetalParticleSize">5</x:Double>
  <x:Double x:Key="PetalParticleCount">8</x:Double>
  <x:Double x:Key="PetalParticleOpacity">0.04</x:Double>
  <x:Double x:Key="PetalTrailLength">5</x:Double>
  <x:Double x:Key="PetalFallDuration">3000</x:Double>

</ResourceDictionary>