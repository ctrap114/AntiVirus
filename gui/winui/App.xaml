<Application
    x:Class="EverbloomSecurity.GUI.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EverbloomSecurity.GUI.WinUI">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- XamlControlsResources provides default WinUI styles -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                
                <!-- Everbloom Design System -->
                <ResourceDictionary Source="ms-appx:///Resources/Themes/BrandTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Themes/MaterialAdapters.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 APPLICATION-WIDE RESOURCES
                 ============================================================ -->
            
            <!-- Window Background - Set by MaterialAdapter at runtime -->
            <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource ColorBackground}" />
            
            <!-- Default Font Family -->
            <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
            
            <!-- Default Font Sizes -->
            <x:Double x:Key="DefaultFontSize">13</x:Double>
            
            <!-- Corner Radius for Controls -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            
            <!-- Default Button Style -->
            <Style TargetType="Button" BasedOn="{StaticResource EverbloomButtonStyle}" />
            
            <!-- Default Card Style -->
            <Style TargetType="local:EverbloomCard" BasedOn="{StaticResource EverbloomCardStyle}" />
            
            <!-- NavigationView Style -->
            <Style TargetType="local:EverbloomNavigationView" BasedOn="{StaticResource EverbloomNavigationViewStyle}" />
            
            <!-- Scan Ring Style -->
            <Style TargetType="local:EverbloomScanRing" BasedOn="{StaticResource EverbloomScanRingStyle" />

        </ResourceDictionary>
    </Application.Resources>
</Application>